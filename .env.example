# Copy to .dev.vars for local development:  cp .env.example .dev.vars
# In production, set these in Cloudflare (dashboard or `wrangler pages secret put`).
# Placeholder names only. Never put real values in this file.

# --- Secrets (server only) ---
CSRF_SECRET=replace-with-a-random-string-of-at-least-32-characters
TURNSTILE_SECRET_KEY=replace-with-your-turnstile-secret-key
RESEND_API_KEY=replace-with-your-resend-api-key

# --- Public, but configured on the server so nothing is hard-coded in the HTML ---
TURNSTILE_SITE_KEY=replace-with-your-turnstile-site-key

# --- Email routing ---
CONTACT_TO_EMAIL=shop-inbox@your-domain.example
CONTACT_FROM_EMAIL="Vernon Auto Repair Website <callbacks@your-domain.example>"

# --- Request checks ---
# Comma-separated list of origins allowed to post the form (no trailing slash)
ALLOWED_ORIGINS=https://your-domain.example,https://www.your-domain.example
# Optional: hostnames Turnstile must report (comma-separated)
TURNSTILE_HOSTNAMES=your-domain.example,www.your-domain.example

# --- Local development only ---
# Set to "console" to skip sending email on localhost. Refused on any other host.
# EMAIL_TRANSPORT=console
